# Email Configuration
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Payment Notification Email Configuration
# Set to 'true' to send payment notification emails, 'false' to print to terminal/log
# Note: OTP (login) emails are ALWAYS sent regardless of this setting
EMAIL_ENABLED=false

# Reminder System Configuration
# Set to 'true' to enable reminder system, 'false' to disable
REMINDER_ENABLED=true

# Number of days before sending payment reminders
REMINDER_DAYS_THRESHOLD=7

# Application URL (used for generating links in emails)
APP_URL=http://localhost:5000
